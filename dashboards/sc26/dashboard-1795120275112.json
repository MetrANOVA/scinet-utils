                        },
                        "pluginVersion": "4.23.5",
                        "queryType": "timeseries",
                        "rawSql": "SELECT $__timeInterval(start_time) AS time, device_id, sum(bit_count)/8 as Volume\nFROM data_flow\nWHERE ( device_id IN (\n  SELECT device_id\n  FROM data_flow\n  GROUP BY device_id\n  ORDER BY sum(bit_count) DESC\n  LIMIT 10\n  )\n)\nAND $__timeFilter(start_time) AND device_ref IS NOT NULL\nGROUP BY device_id, time\nORDER BY time, Volume ASC"
                      },
                      "labels": {
                        "grafana.app/export-label": "grafana-clickhouse-datasource-1",
