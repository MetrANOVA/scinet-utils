                        "pluginVersion": "4.23.5",
                        "queryType": "timeseries",
                        "rawSql": "SELECT\n  $__timeInterval(observation_time) AS time,\n  (sum(in_bits_delta) + sum(out_bits_delta)) / $__interval_s as Rate\nFROM\n  data_interface_traffic_view (\n    ids = ['scn-sw-arst-1', 'scn-sw-arst-2', 'scn-sw-cela-3'],\n    from = $__fromTime,\n    to = $__toTime\n  )\nWHERE\n  $__timeFilter(observation_time)\n  AND observation_time != '2026-11-16 20:48:00'\n  AND observation_time != '2026-11-16 20:30:00'\n  AND interface_id IN (\n    SELECT\n      id\n    FROM\n      meta_interface\n    WHERE\n      flow_index IS NOT NULL\n      AND description LIKE '%5438%'\n    GROUP BY\n      id\n    ORDER BY\n      id\n  )\nGROUP BY\n  time\nORDER BY\n  time ASC"
                      },
                      "labels": {
                        "grafana.app/export-label": "grafana-clickhouse-datasource-1",
                        "grafana.app/export-datasource-name": "MetrANOVA ClickHouse"
