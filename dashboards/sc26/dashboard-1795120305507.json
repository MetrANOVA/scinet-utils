                        "pluginVersion": "4.23.5",
                        "queryType": "table",
                        "rawSql": "  SELECT Booth, Organization, sum(Volume)\n  FROM (\n  SELECT \n  dictGet('meta_ip_scinet_dict', 'id', ext.dst_ip_scinet_ref) AS Booth,\n  dictGet('meta_ip_scinet_dict', 'organization_name', ext.dst_ip_scinet_ref) AS Organization,\n  sum(bit_count)/8 AS Volume\n  FROM \"metranova\".\"data_flow\" \n  WHERE Booth IS NOT NULL AND Booth != ''\n    AND ip_version = 6\n    AND device_ref IS NOT NULL\n  GROUP BY Booth, Organization\n  ORDER BY Volume DESC\n  LIMIT 100\n\n  UNION ALL\n\n  SELECT \n  dictGet('meta_ip_scinet_dict', 'id', ext.src_ip_scinet_ref) AS Booth,\n  dictGet('meta_ip_scinet_dict', 'organization_name', ext.src_ip_scinet_ref) AS Organization,\n  sum(bit_count)/8 AS Volume\n  FROM \"metranova\".\"data_flow\" \n  WHERE Booth IS NOT NULL AND Booth != ''\n    AND ip_version = 6 AND out_interface_edge=true\n  GROUP BY Booth, Organization\n  ORDER BY Volume DESC\n  LIMIT 100\n  )\n  GROUP BY Booth, Organization\n  ORDER BY sum(Volume) DESC\n  LIMIT 20"
                      },
                      "labels": {
