                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "4.23.5",
                        "queryType": "table",
                        "rawSql": "  SELECT \n  dictGet('meta_ip_scinet_dict', 'id', ext.dst_ip_scinet_ref) AS Booth,\n  dictGet('meta_ip_scinet_dict', 'organization_name', ext.dst_ip_scinet_ref) AS Organization,\n  sum(bit_count)/8 AS Volume\n  FROM \"metranova\".\"data_flow\" \n  WHERE Booth IS NOT NULL AND Booth != '' \n  AND device_id IN ['conf-rtr-jnpr-1','conf-rtr-jnpr-2']\n  AND Organization NOT IN ['dNOC']\n  AND $__timeFilter(start_time) \n  GROUP BY Booth, Organization\n  ORDER BY Volume DESC\n  LIMIT 7"
                      },
                      "labels": {
                        "grafana.app/export-label": "grafana-clickhouse-datasource-1",
                        "grafana.app/export-datasource-name": "MetrANOVA ClickHouse"
                      }
