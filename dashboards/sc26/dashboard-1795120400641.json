      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Top 10 Booths by Volume",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-clickhouse-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "metranova-clickhouse"
                      },
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
                            "mode": "list",
                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "4.23.5",
                        "queryType": "table",
                        "rawSql": "SELECT \n  $__timeInterval(start_time) AS time, \n  COALESCE(\n    dictGet('meta_ip_scinet_dict', 'organization_name', ext.src_ip_scinet_ref),\n    dictGet('meta_ip_scinet_dict', 'organization_name', ext.dst_ip_scinet_ref)) AS Booth,\n  sum(bit_count)/8 as Volume\nFROM data_flow\nWHERE ( Booth IN (\n    SELECT \n    COALESCE(\n    dictGet('meta_ip_scinet_dict', 'organization_name', ext.src_ip_scinet_ref),\n    dictGet('meta_ip_scinet_dict', 'organization_name', ext.dst_ip_scinet_ref)) AS Booth\n  FROM data_flow\n  WHERE Booth IS NOT NULL AND Booth NOT IN ['dNOC']\n  GROUP BY Booth\n  ORDER BY sum(bit_count) DESC\n  LIMIT 10\n  )\n)\nAND $__timeFilter(start_time)\nGROUP BY Booth, time\nORDER BY time ASC"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
